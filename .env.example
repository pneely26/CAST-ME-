# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stewart_blind_spot?schema=public"

# Single-user login. Generate the hash with:  npm run hash-password -- "your-password"
APP_USERNAME="paige"
APP_PASSWORD_HASH=""

# Secret used to sign the session cookie (32+ random chars). e.g.  openssl rand -base64 48
SESSION_SECRET=""

# Days after which a record's "last verified" date is considered STALE
STALE_AFTER_DAYS=14

# Days before a submission deadline that triggers a DEADLINE_APPROACHING alert
DEADLINE_ALERT_DAYS=3

# Future: email alerts (not required; in-app alerts work without these)
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# ALERT_EMAIL_TO=""

# Future: permitted public-data APIs. Never put Actors Access / Breakdown Express
# or agency credentials here - this app does not use them.
# EXAMPLE_PUBLIC_API_KEY=""

# ---- Web-wide search (optional; pick one) ----
# Brave Search API (free plan available): https://api-dashboard.search.brave.com
# BRAVE_SEARCH_API_KEY=""
# Google Programmable Search: API key + search engine ID
# GOOGLE_CSE_KEY=""
# GOOGLE_CSE_ID=""
# SEARCH_PROVIDER="brave"   # or "google" if both are set

# ---- Email inbox (optional) ----
# Reads ONE folder/label of your own mailbox, read-only. Use an app password, not your normal password.
# IMAP_HOST="imap.gmail.com"
# IMAP_PORT=993
# IMAP_USER="you@gmail.com"
# IMAP_PASSWORD=""
# IMAP_FOLDER="Casting"
# AGENT_EMAILS="youragency.com"   # addresses or domains of your agents, comma-separated
