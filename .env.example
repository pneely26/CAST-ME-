# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stewart_blind_spot?schema=public"

# Single-user login. Generate the hash with:  npm run hash-password -- "your-password"
APP_USERNAME="paige"
APP_PASSWORD_HASH=""

# Secret used to sign the session cookie (32+ random chars). e.g.  openssl rand -base64 48
SESSION_SECRET=""

# Days after which a record's "last verified" date is considered STALE
STALE_AFTER_DAYS=14

# Days before a submission deadline that triggers a DEADLINE_APPROACHING alert
DEADLINE_ALERT_DAYS=3

# Future: email alerts (not required; in-app alerts work without these)
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# ALERT_EMAIL_TO=""

# Future: permitted public-data APIs. Never put Actors Access / Breakdown Express
# or agency credentials here - this app does not use them.
# EXAMPLE_PUBLIC_API_KEY=""
