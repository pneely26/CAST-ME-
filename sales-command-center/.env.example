# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sales_command_center"
# Long random string (e.g. `openssl rand -base64 48`). Changing it signs everyone out.
SESSION_SECRET=""
APP_TIMEZONE="America/Chicago"
UPLOAD_DIR="./uploads"

# Screenshot import (optional). Without a key, screenshots are stored and leads are typed in by hand.
# Used only on the server; never sent to the browser.
ANTHROPIC_API_KEY=""
# EXTRACTION_MODEL="claude-opus-5-5"
# Set to "none" to turn screenshot reading off even when a key is present.
# EXTRACTION_PROVIDER="anthropic"
